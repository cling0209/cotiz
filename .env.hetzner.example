# Hetzner VPS — copiar en el servidor como .env.prod (no commitear)
# Romulo: /opt/cotiz-romulo/.env.prod   → APP_PORT=8001  POSTGRES_PORT=5433
# Reicol: /opt/cotiz-reicol/.env.prod   → APP_PORT=8002  POSTGRES_PORT=5434
# POSTGRES_USER = DB_USERNAME; DB_PASSWORD = POSTGRES_PASSWORD

APP_NAME="Cotiza Rómulo"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://cotiza.romulo.cl
ASSET_URL=https://cotiza.romulo.cl
APP_TIMEZONE=America/Santiago

APP_PORT=8001
POSTGRES_PORT=5433

MAINTENANCE_MODE=false

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=romulo
DB_USERNAME=romulo
DB_PASSWORD=
POSTGRES_DB=romulo
POSTGRES_USER=romulo
POSTGRES_PASSWORD=

CACHE_STORE=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=43200

RUN_QUEUE_WORKER=true
RUN_SCHEDULER=true
RUN_MIGRATIONS=true
RUN_SEED=false

# Correo producción (Resend recomendado; no usar mailpit en VPS)
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=tienda@romulo.cl
MAIL_FROM_NAME="Cotiza Rómulo"

ADMIN_OTP_ENABLED=false
LOG_CHANNEL=stderr
LOG_LEVEL=error

# Cotiz — negocio (ver config/cotiz.php y RENDER.md)
COTIZ_SISTEMA=Romulo
COTIZ_EMPRESA_RUT=76.185.139-K
COTIZ_ROMULO_RUT=76.185.139-K
COTIZ_REICOL_RUT=76.356.855-5
COTIZ_CODIGO_BODEGA=01
COTIZ_CONCEPTO_BODEGA=26
COTIZ_CODIGO_PROVEEDOR=
COTIZ_FACTOR_PRECIO_VENTA=1.22
COTIZ_PROD_VALOR_FECHA_MESES=3
COTIZ_API_USUARIO_URL=https://cotiza.reicol.cl/api/v1/usuario
COTIZ_API_NOTA_USER=
COTIZ_API_NOTA_PASSWORD=
COTIZ_API_CONSULTA_NRO_COTIZACION=https://cotiza.reicol.cl/api/v1/nota-consulta

MERCADOPUBLICO_ANALISIS_ADMIN=true
MERCADOPUBLICO_TICKET=
MERCADOPUBLICO_FECHA_INICIO_BUSQUEDA=2026-07-14
MERCADOPUBLICO_RESULTADOS_SCHEDULE=true
MERCADOPUBLICO_RESULTADOS_SCHEDULE_HOURS=5,16,21
MERCADOPUBLICO_RESULTADOS_CATCHUP_LOGIN=false
MERCADOPUBLICO_RESULTADOS_SKIP_MISMO_DIA=true

# Mistral OCR para importar tablas de PDF (nativo o escaneado)
COTIZ_MISTRAL_OCR_ENABLED=true
COTIZ_MISTRAL_API_KEY=
COTIZ_MISTRAL_OCR_MODEL=mistral-ocr-latest
COTIZ_MISTRAL_OCR_TIMEOUT=240
COTIZ_MISTRAL_OCR_ANNOTATION=true

MAEPROD_IMPORT_BACKGROUND=true

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=romulo-imagenes
R2_ENDPOINT=
R2_PUBLIC_URL=
R2_IMAGE_PREFIX=productos
R2_REGION=auto
PRODUCT_STORAGE_DISK=r2
R2_ADJUNTOS_DISK=r2_adjuntos
R2_ADJUNTOS_BUCKET=mp-adjuntos
R2_ADJUNTOS_PREFIX=
PRODUCT_IMAGE_BASE_URL=

# Sidecar tablas PDF (CX33): structure = PP-Structure. Reicol puede usar tesseract si falta RAM.
PADDLEOCR_MODE=structure
PADDLEOCR_DPI=150

L5_SWAGGER_GENERATE_ALWAYS=false

# --- Solo durante migración desde Render Postgres (borrar tras render-dump.sh) ---
# RENDER_SOURCE_HOST=dpg-xxxxx-a.oregon-postgres.render.com
# RENDER_SOURCE_DB=romulo
# RENDER_SOURCE_USER=romulo
# RENDER_SOURCE_PASSWORD=

