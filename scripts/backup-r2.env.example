# Copiar en el VPS como /etc/cotiz-backup/backup-r2.env (chmod 600, no commitear).
# Uso: BACKUP_CONFIG=/etc/cotiz-backup/backup-r2.env bash scripts/backup-all-dbs-to-r2.sh

# Cloudflare R2 (bucket privado, distinto de romulo-imagenes)
R2_BACKUP_BUCKET=romulo-bases
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Directorio temporal en el VPS (se limpia tras subir si KEEP_LOCAL_AFTER_UPLOAD=false)
LOCAL_BACKUP_DIR=/var/backups/postgres
LOCAL_RETENTION_DAYS=3
KEEP_LOCAL_AFTER_UPLOAD=false

# Una línea por base: APP_DIR|nombre_en_r2|POSTGRES_USER|POSTGRES_DB|[compose_file]
# compose_file opcional (default docker-compose.prod.yml)
BACKUP_TARGETS=(
  "/opt/carro|carro|carro|carro"
  "/opt/cotiz-romulo|romulo|romulo|romulo"
  "/opt/cotiz-reicol|reicol|reicol|reicol"
)
